{
  "name": "S3 Browser Notebook",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    // Java for the PySpark notebook
    "ghcr.io/devcontainers/features/java:1": { "version": "21" }
  },
  "postCreateCommand": "pip install -r requirements.txt && nbstripout --install",
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": { "label": "JupyterLab", "onAutoForward": "openBrowser" }
  },
  "secrets": {
    "S3_ASSUMEROLE_CONFIG_B64": {
      "description": "Optional. Your config JSON, base64-encoded (base64 -w0 credentials.json). Without it, put the file at .secrets/credentials.json in the codespace.",
      "documentationUrl": "https://github.com/dprophet/s3-browser-notebook#config"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"]
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
